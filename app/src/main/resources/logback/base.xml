<?xml version="1.0" encoding="UTF-8"?>
<included>
	<include resource="logback/defaults.xml"/>
	<include resource="logback/console-appender.xml"/>
	<include resource="logback/rolling-file-appender.xml"/>

	<root level="INFO">
		<if condition='!p("consoleOutputEnabled").equals("false")'>
			<then>
				<appender-ref ref="CONSOLE" />
			</then>
		</if>

		<if condition='!p("fileOutputEnabled").equals("false")'>
			<then>
				<appender-ref ref="FILE" />
			</then>
		</if>
	</root>

	<logger name="ch.qos.logback" level="ERROR"/>
	<logger name="org.jooq.Constants" level="WARNING"/>
</included>