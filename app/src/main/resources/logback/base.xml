<?xml version="1.0" encoding="UTF-8"?>
<included>
	<include resource="logback/defaults.xml"/>
	<include resource="logback/console-appender.xml"/>
	<include resource="logback/rolling-file-appender.xml"/>

	<root level="INFO">
		<condition class="ch.qos.logback.core.boolex.ExpressionPropertyCondition">
			<expression>propertyEquals("consoleOutputEnabled", "true")</expression>
		</condition>
		<if>
			<then>
				<appender-ref ref="CONSOLE" />
			</then>
		</if>

		<condition class="ch.qos.logback.core.boolex.ExpressionPropertyCondition">
			<expression>propertyEquals("fileOutputEnabled", "true")</expression>
		</condition>
		<if>
			<then>
				<appender-ref ref="FILE" />
			</then>
		</if>
	</root>

	<logger name="ch.qos.logback" level="ERROR"/>
	<logger name="org.jooq.Constants" level="WARNING"/>
</included>